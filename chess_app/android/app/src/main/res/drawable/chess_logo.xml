    <!-- 4 horizontal lines at y=21,39,57,75; 4 vertical lines at x=21,39,57,75 -->
    <path
        android:pathData="M21,21 L75,21 M21,39 L75,39 M21,57 L75,57 M21,75 L75,75
                          M21,21 L21,75 M39,21 L39,75 M57,21 L57,75 M75,21 L75,75"
