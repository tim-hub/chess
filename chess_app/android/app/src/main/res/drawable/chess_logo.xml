    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Green rounded square background -->
    <path
        android:pathData="M20,0 L76,0 Q96,0 96,20 L96,76 Q96,96 76,96 L20,96 Q0,96 0,76 L0,20 Q0,0 20,0 Z"
        android:fillColor="#769656"/>

    <!-- 3x3 white grid (grid_on icon) — occupies ~55% of the square, centered -->
